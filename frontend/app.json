{
  "expo": {
    "name": "Connect",
    "slug": "connect",
    "scheme": "connect",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "notification": {
      "icon": "./assets/images/icon.png",
      "color": "#0095f6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.connect.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Connect needs access to your camera for video calls.",
        "NSMicrophoneUsageDescription": "Connect needs access to your microphone to let you make voice and video calls.",
        "UIBackgroundModes": [
          "voip",
          "audio",
          "fetch",
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.connect.app",
      "softwareKeyboardLayoutMode": "resize",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.MANAGE_OWN_CALLS",
        "android.permission.READ_PHONE_STATE",
        "android.permission.USE_FULL_SCREEN_INTENT", 
        "android.permission.FOREGROUND_SERVICE", 
        "android.permission.WAKE_LOCK"
      ]
    },
    "extra": {
      "vapidPublicKey": "BNiug5Sm-HTCeXav2TwHe-ciE7ORzGLTud4meHEtRjHKIBSeIAnvOt1Lh3_QKb3sOu-opZuDfXqqjK2_3OSazHM",
      "eas": {
        "projectId": "5ba69721-0fca-4d14-8f9b-744fc9cc8fbe"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-notifications",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Connect to access your camera",
          "microphonePermission": "Allow Connect to access your microphone"
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow Connect to access your camera for calls",
          "microphonePermission": "Allow Connect to access your microphone for calls"
        }
      ],
      [
        "@config-plugins/react-native-callkeep",
        {
          "android": {
            "imageName": "ic_launcher",
            "selfManaged": true
          }
        }
      ]
    ],
    "owner": "arsh2128"
  }
}