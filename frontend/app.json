{
  "expo": {
    "name": "Connect",
    "slug": "connect",
    "scheme": "connect",
    "version": "2.3.8",

    "orientation": "portrait",
    "userInterfaceStyle": "automatic",

    "jsEngine": "jsc",

    "assetBundlePatterns": [
      "**/*"
    ],

    "notification": {
      "icon": "./assets/images/icon.png",
      "color": "#0095f6"
    },

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.connect.app",
      "bitcode": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Connect needs access to your camera for calls.",
        "NSMicrophoneUsageDescription": "Connect needs access to your microphone for calls.",
        "UIBackgroundModes": [
          "audio",
          "fetch",
          "remote-notification",
          "voip"
        ]
      }
    },

    "android": {
      "package": "com.connect.app",
      "softwareKeyboardLayoutMode": "resize",
      "googleServicesFile": "./google-services.json",

      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.WAKE_LOCK",
        "android.permission.VIBRATE",

        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_CAMERA",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.FOREGROUND_SERVICE_PHONE_CALL",

        "android.permission.MANAGE_OWN_CALLS",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.READ_PHONE_STATE",
        "android.permission.BIND_TELECOM_CONNECTION_SERVICE",
        "android.permission.READ_PHONE_NUMBERS",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },

    "web": {
      "bundler": "metro"
    },

    "extra": {
      "vapidPublicKey": "BNiug5Sm-HTCeXav2TwHe-ciE7ORzGLTud4meHEtRjHKIBSeIAnvOt1Lh3_QKb3sOu-opZuDfXqqjK2_3OSazHM",
      "eas": {
        "projectId": "a4844a00-642a-4045-9d32-ace3e35e22ce"
      }
    },

    "plugins": [
      "./plugins/withAndroidPermissions",

      "expo-notifications",
      "expo-sqlite",
      "expo-secure-store",
      "expo-task-manager",
      "expo-background-fetch",

      [
        "expo-build-properties",
        {
          "android": {
            "newArchEnabled": true,
            "extraProguardRules": "-keep class io.wazo.callkeep.** { *; }",
            "manifestPlaceholders": {
              "foregroundServiceType": "camera|microphone|phoneCall"
            }
          },
          "ios": {
            "newArchEnabled": true
          }
        }
      ],

      [
        "expo-camera",
        {
          "cameraPermission": "Allow Connect to access your camera",
          "microphonePermission": "Allow Connect to access your microphone"
        }
      ],

      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow Connect to access your camera for calls",
          "microphonePermission": "Allow Connect to access your microphone for calls"
        }
      ],

      [
        "@config-plugins/react-native-callkeep",
        {
          "android": {
            "imageName": "ic_launcher",
            "selfManaged": true
          }
        }
      ]
    ],

    "owner": "arsh2128"
  }
}
