{
  "expo": {
    "name": "SocialConnect",
    "slug": "socialconnect",
    "scheme": "socialconnect",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "notification": {
      "vapidPublicKey": "BNiug5Sm-HTCeXav2TwHe-ciE7ORzGLTud4meHEtRjHKIBSeIAnvOt1Lh3_QKb3sOu-opZuDfXqqjK2_3OSazHM"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.connect.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "SocialConnect needs access to your microphone to let you make voice and video calls.",
        "NSCameraUsageDescription": "SocialConnect needs access to your camera for video calls."
      }
    },
    "android": {
      "package": "com.connect.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "NOTIFICATIONS",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "5ba69721-0fca-4d14-8f9b-744fc9cc8fbe"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SocialConnect to access your camera",
          "microphonePermission": "Allow SocialConnect to access your microphone"
        }
      ]
    ],
    "owner": "arsh2128"
  }
}